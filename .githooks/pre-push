#!/bin/sh
# NYUS runs no GitHub Actions (owner directive 2026-08-06). The ONLY workflow
# that may exist for this repo is GitHub's built-in `pages-build-deployment`,
# which is generated by Pages itself and never lives in .github/workflows — so
# anything appearing there is an authored workflow and is blocked.
#
# Install (once per machine):  git config core.hooksPath .githooks
# Emergency bypass:            git push --no-verify
found=$(git ls-files --cached --others --exclude-standard .github/workflows)
if [ -n "$found" ]; then
  echo "✘ pre-push blocked: authored GitHub Actions workflow(s) — NYUS runs none."
  echo "$found" | sed 's/^/    /'
  exit 1
fi
exit 0
